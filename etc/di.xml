<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <virtualType name="Yireo\EasierExtensionAttributes\Config\Data" type="Magento\Framework\Config\Data">
        <arguments>
            <argument name="reader" xsi:type="object">Yireo\EasierExtensionAttributes\Config\Reader\Filesystem</argument>
            <argument name="cacheId" xsi:type="string">yireo_easier_extension_attributes</argument>
        </arguments>
    </virtualType>

    <type name="Yireo\EasierExtensionAttributes\Config\Provider">
        <arguments>
            <argument name="configData" xsi:type="object">Yireo\EasierExtensionAttributes\Config\Data</argument>
        </arguments>
    </type>

    <type name="Magento\InventoryApi\Api\SourceRepositoryInterface">
        <plugin name="Yireo_EasierExtensionAttributes::AddExtensionAttributesToAnyEntity"
                type="Yireo\EasierExtensionAttributes\Plugin\AddExtensionAttributesToEntity"/>
    </type>

    <type name="Magento\Catalog\Api\ProductRepositoryInterface">
        <plugin name="Yireo_EasierExtensionAttributes::AddExtensionAttributesToAnyEntity"
                type="Yireo\EasierExtensionAttributes\Plugin\AddExtensionAttributesToEntity"/>
    </type>

    <type name="Magento\Catalog\Api\CategoryRepositoryInterface">
        <plugin name="Yireo_EasierExtensionAttributes::AddExtensionAttributesToAnyEntity"
                type="Yireo\EasierExtensionAttributes\Plugin\AddExtensionAttributesToEntity"/>
    </type>

    <!--
    <type name="Magento\Customer\Api\CustomerRepositoryInterface">
        <plugin name="Yireo_EasierExtensionAttributes::AddExtensionAttributesToAnyEntity"
                type="Yireo\EasierExtensionAttributes\Plugin\AddExtensionAttributesToEntity"/>
    </type>
    -->
</config>
